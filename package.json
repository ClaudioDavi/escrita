{
  "name": "obsidian-escrita",
  "version": "0.7.0",
  "description": "Obsidian plugin for fiction writers: outline with ghost beats, word goals, sprints, placeholders, darlings.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node build-css.mjs && node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node build-css.mjs && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:bundle": "ESCRITA_REQUIRE_BUNDLE=1 vitest run tests/no-network.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "writing",
    "fiction",
    "novel",
    "outline",
    "word-count"
  ],
  "author": "Claudio Davi",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.5",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
